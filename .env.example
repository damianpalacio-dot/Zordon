# Copy to .env and fill in what you use. Everything is optional.

# --- Server ---
PORT=4000
# The ROOT of your GEC2 OneDrive. Zordon files into "5. PROJECTS/<Job #>/..." and keeps its own files in "Zordon/".
# Windows: ZORDON_VAULT=C:\Users\Damian\OneDrive - <company>
ZORDON_VAULT=
# Where job folders live, relative to the vault root (default "5. PROJECTS")
# ZORDON_PROJECTS_DIR=5. PROJECTS
# Set a long random secret before exposing Zordon beyond this computer.
ZORDON_API_TOKEN=

# --- Claude (smarter email triage and file naming) ---
ANTHROPIC_API_KEY=
# ZORDON_MODEL=claude-opus-5-5

# --- Voice: off to silence the computer voice ---
# ZORDON_VOICE=off
# ZORDON_MAC_VOICE=Daniel

# --- Procore (RFIs & submittals) ---
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=
# Job number : Procore project id pairs, comma separated (the project id is the number in the project URL)
# e.g. PROCORE_PROJECTS=G2707:562949953421312,G3249:562949953425000
PROCORE_PROJECTS=
# Your Procore login email(s), so items assigned to you land on your list
PROCORE_ME=

# --- Autodesk Construction Cloud / Forma (APS) ---
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Your Autodesk user id (lets a server token act as you)
APS_USER_ID=
# Job number : ACC project id pairs, e.g. ACC_PROJECTS=G3052:b.1234abcd-...
ACC_PROJECTS=
# Your Autodesk email(s) or user id(s)
ACC_ME=

# How often to sync Procore/Autodesk (minutes)
ZORDON_SYNC_MINUTES=30
