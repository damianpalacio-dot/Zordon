# Copy to .env and fill in what you use. Everything is optional.

# --- Server ---
PORT=4000
# Where files are named and filed. Point it at your OneDrive folder to sync everywhere, e.g.
# Windows: ZORDON_VAULT=C:\Users\Damian\OneDrive - Company\Zordon
# Mac:     ZORDON_VAULT=/Users/damian/Library/CloudStorage/OneDrive-Company/Zordon
ZORDON_VAULT=
# Set a long random secret before exposing Zordon beyond this computer.
ZORDON_API_TOKEN=

# --- Claude (smarter email triage and file naming) ---
ANTHROPIC_API_KEY=
# ZORDON_MODEL=claude-opus-5-5

# --- Voice: off to silence the computer voice ---
# ZORDON_VOICE=off
# ZORDON_MAC_VOICE=Daniel

# --- Procore (RFIs & submittals) ---
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=
# zordonProjectId:procoreProjectId pairs, comma separated
PROCORE_PROJECTS=
# Your Procore login email(s), so items assigned to you land on your list
PROCORE_ME=

# --- Autodesk Construction Cloud / Forma (APS) ---
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Your Autodesk user id (lets a server token act as you)
APS_USER_ID=
# zordonProjectId:accProjectId pairs
ACC_PROJECTS=
# Your Autodesk email(s) or user id(s)
ACC_ME=

# How often to sync Procore/Autodesk (minutes)
ZORDON_SYNC_MINUTES=30
